rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing Turnbull family tasks collection (Preserved!)
    match /turnbull_reset_tasks/{taskId} {
      allow read, write: if true;
    }

    // Dynamic Multi-Family Boards: tasks and board settings
    match /boards/{boardId} {
      allow read, write: if true;

      match /tasks/{taskId} {
        allow read, write: if true;
      }
    }
  }
}
