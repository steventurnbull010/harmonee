rules_version = '2';

// harmonee security model
// -----------------------
// Every device signs in anonymously (Firebase Auth). A device may read or
// write a household board only after it has "joined" that board by
// presenting the board's family code once:
//
//   boards/{boardId}                       board settings, calendar, meals, lists
//   boards/{boardId}/tasks/{taskId}        chores & routines
//   boards/{boardId}/recipePhotos/{id}     photos of the family's own dishes
//   boards/{boardId}/private/access        { code } — the family code
//   boards/{boardId}/devices/{uid}         one doc per joined device
//
// Joining = creating devices/{uid} with a `code` matching private/access.
// A brand-new board is created in one batch: board doc + private/access +
// the creator's device doc.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(boardId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boards/$(boardId)/devices/$(request.auth.uid));
    }

    function isMemberAfter(boardId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/boards/$(boardId)/devices/$(request.auth.uid));
    }

    function validCode(code) {
      return code is string && code.size() >= 8 && code.size() <= 16;
    }

    match /boards/{boardId} {
      allow read, update: if isMember(boardId);
      // New board: created together with its access code and the creator's device
      allow create: if isMemberAfter(boardId)
        && existsAfter(/databases/$(database)/documents/boards/$(boardId)/private/access);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read, write: if isMember(boardId);
      }

      // Photos of the family's own dishes (js/recipe-photos.js): one small
      // JPEG per recipe, kept out of the board document so it stays small
      match /recipePhotos/{recipeId} {
        allow read, delete: if isMember(boardId);
        allow create, update: if isMember(boardId)
          && recipeId.size() <= 80
          && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 400000
          && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      }

      // Google / Outlook / iCloud calendar links (js/google-calendar.js):
      // a device can save or remove a link, but never read one back; only
      // the server (functions/index.js) reads them
      match /private/calendarLinks {
        allow read: if false;
        allow create, update: if isMember(boardId)
          && request.resource.data.keys().hasOnly(['links', 'updatedAt'])
          && request.resource.data.links is map
          && request.resource.data.links.size() <= 20;
        allow delete: if false;
      }
      // The server's own note of when it last checked
      match /private/calendarSync {
        allow read, write: if false;
      }
      // Each person's events from their linked calendar, written by the server
      match /externalEvents/{personKey} {
        allow read: if isMember(boardId);
        allow write: if false;
      }

      match /private/access {
        allow read: if isMember(boardId);
        // Only when the board itself is being created in the same batch
        allow create: if signedIn()
          && !exists(/databases/$(database)/documents/boards/$(boardId))
          && isMemberAfter(boardId)
          && validCode(request.resource.data.code);
        // Members can rotate the code
        allow update: if isMember(boardId) && validCode(request.resource.data.code);
        allow delete: if false;
      }

      match /devices/{deviceId} {
        // A device can always check whether it has joined; members can list devices
        allow get: if signedIn() && (request.auth.uid == deviceId || isMember(boardId));
        allow list: if isMember(boardId);
        // Join: only for yourself, and only with the right family code
        allow create: if signedIn()
          && request.auth.uid == deviceId
          && request.resource.data.code
             == getAfter(/databases/$(database)/documents/boards/$(boardId)/private/access).data.code;
        allow update: if isMember(boardId) && request.auth.uid == deviceId
          && request.resource.data.code == resource.data.code;
        // Members can remove any device (e.g. a lost phone)
        allow delete: if isMember(boardId);
      }
    }

    // Film night (js/film-night.js): one list per streaming service, shared by
    // every board. Any signed-in device can read it; the first device after
    // Sunday 6pm writes the new week's list. Writes must be the right shape and
    // at least 3 days apart, so the list can't be rewritten over and over.
    match /streaming/{serviceId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && serviceId in ['netflix', 'prime', 'disney', 'apple', 'iplayer', 'itvx', 'all4', 'now', 'paramount']
        && request.resource.data.keys().hasOnly(['popular', 'latest', 'fetchedAt'])
        && request.resource.data.popular is list && request.resource.data.popular.size() <= 25
        && request.resource.data.latest is list && request.resource.data.latest.size() <= 25
        && request.resource.data.fetchedAt == request.time
        && (resource == null || request.time > resource.data.fetchedAt + duration.value(3, 'd'));
      allow delete: if false;
    }

    // List-only links (js/lists.js, list.html): a copy of one list, kept under
    // a long random key by the family's devices. Knowing the key lets a device
    // read that copy and leave "add" or "tick" notes for the family's devices
    // to apply. Keys can't be listed, so they can't be found by looking.
    // Only family devices make, update or delete the copy (deleting it is
    // "Stop the link working").
    match /sharedLists/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if key.size() >= 18 && key.size() <= 40
        && isMember(request.resource.data.boardId)
        && request.resource.data.keys().hasOnly(['boardId', 'listId', 'title', 'emoji', 'color', 'items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 300
        && (resource == null || request.resource.data.boardId == resource.data.boardId);
      allow delete: if isMember(resource.data.boardId);

      match /ops/{opId} {
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/sharedLists/$(key))
          && request.resource.data.at == request.time
          && (
            (request.resource.data.keys().hasOnly(['type', 'texts', 'at'])
              && request.resource.data.type == 'add'
              && request.resource.data.texts is list
              && request.resource.data.texts.size() >= 1 && request.resource.data.texts.size() <= 10)
            || (request.resource.data.keys().hasOnly(['type', 'itemId', 'checked', 'at'])
              && request.resource.data.type == 'tick'
              && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 80
              && request.resource.data.checked is bool)
          );
        allow read, delete: if isMember(get(/databases/$(database)/documents/sharedLists/$(key)).data.boardId);
        allow update: if false;
      }
    }

    // Everything else, including the legacy turnbull_reset_tasks collection, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
